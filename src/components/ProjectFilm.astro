---
import Photo from './Photo.astro';
import {withBase} from '../data/urls';
import {choose,type Locale} from '../data/i18n';
interface Props { video:string; title:string; locale:Locale; }
const {video,title,locale}=Astro.props,t=choose(locale);
---
<figure class="game-film">
  <button type="button" class="game-film-preview" data-film={video} data-title={title} data-poster={withBase('/images/stormframe-1-1920.webp')} aria-label={t('播放 STORMFRAME 游戏影片','Play STORMFRAME gameplay film')}>
    <Photo image="stormframe-1" alt={t('STORMFRAME 第一人称机甲战斗画面','First-person mech combat in STORMFRAME')} sizes="(max-width:900px) 100vw, 90vw"/>
    <span class="game-film-shade" aria-hidden="true"></span>
    <span class="game-film-play" aria-hidden="true">▷</span>
    <span class="game-film-label">{t('观看游戏影片','Watch gameplay film')} <span aria-hidden="true">01:11</span></span>
  </button>
  <figcaption>STORMFRAME <span>{t('游戏画面','GAME FOOTAGE')}</span></figcaption>
</figure>
<style>
  .game-film{margin:0 0 80px}
  .game-film-preview{position:relative;display:block;width:100%;aspect-ratio:21/9;border:0;overflow:hidden;background:var(--bg-deep);color:var(--text)}
  .game-film-preview :global(img){width:100%;height:100%;object-fit:cover}
  .game-film-shade{position:absolute;inset:0;background:linear-gradient(0deg,#090a0cc9,transparent 65%)}
  .game-film-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:72px;height:72px;display:grid;place-items:center;padding-left:4px;border:1px solid currentColor;border-radius:50%;font-size:32px;background:#090a0c33}
  .game-film-preview:hover .game-film-play{background:var(--accent-solid);border-color:var(--accent-solid);color:var(--bg-deep)}
  .game-film-label{position:absolute;inset:auto 32px 24px;display:flex;justify-content:space-between;gap:20px;font-size:14px;letter-spacing:.04em}
  .game-film-label>span{font-size:12px;font-variant-numeric:tabular-nums}
  figcaption{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:10px;letter-spacing:.08em;padding-top:12px}
  @media(max-width:900px){.game-film{margin-bottom:56px}.game-film-preview{aspect-ratio:16/10}.game-film-label{inset:auto 16px 16px;font-size:12px}.game-film-play{width:56px;height:56px;font-size:24px}}
</style>
