---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import {studioData} from '../data/studio-localized';
import {choose,localePath,type Locale} from '../data/i18n';
interface Props {locale:Locale;}
const {locale}=Astro.props,t=choose(locale),href=(p:string)=>localePath(p,locale),{capabilities}=studioData(locale);
---
<Layout title={t('关于我们','About us')} page="studio" locale={locale}>
<header class="about-header page-header"><span class="page-subtitle">{t('关于我们','WHO WE ARE')}</span><h1 class="page-title serif-font">{t('我们创造，','We create')}<br/>{t('可以走入的世界。','worlds to step into.')}</h1><p class="page-intro">{t('LINK SOURCE STUDIO 是一家沉浸式内容与数字体验创作工作室。我们从文化、角色与故事出发，通过视觉与交互，让内容成为可以亲历的体验。','LINK SOURCE STUDIO creates immersive content and digital experiences. Starting with culture, character and story, we use visuals and interaction to create experiences you can step into.')}</p></header>
<section class="about-section"><div class="about-grid"><figure class="about-image"><Photo image="zhongkui-2" alt={t('钟馗项目的奇幻殿宇','A fantastical temple in Zhong Kui')}/></figure><div class="about-text"><h2 class="serif-font">{t('用视觉，构建数字世界。','Building digital worlds through visual art.')}</h2><p>{t('建筑、角色、材质与光影，共同定义一个世界的性格。从宏大的文化空间，到充满想象力的奇幻场景，我们为不同内容寻找合适的视觉表达。','Architecture, characters, materials and light define the character of a world. From cultural spaces to fantastical settings, each story finds its own visual expression.')}</p><p class="highlight-text">{t('让观众走入场景，也走进故事。','Invite the audience into the scene — and into the story.')}</p><p>{t('将内容创意、数字美术与体验设计连接起来，让每一个场景都有存在的理由。','We connect creative content, digital art and experience design, giving each scene a reason to exist.')}</p></div></div></section>
<section class="capability-section" id="capabilities"><div class="section-heading"><span class="page-subtitle">{t('创作能力','WHAT WE DO')}</span><h2 class="serif-font">{t('共同完成一个世界。','Creating a world, together.')}</h2></div><div class="capability-grid">{capabilities.map(c=><article id={c.id}><figure><Photo image={c.image} alt={c.caption} sizes="(max-width:900px) 100vw, 33vw"/></figure><h3 class="serif-font">{c.title}</h3><p class="capability-topics">{c.deliverables.join(' · ')}</p><p>{c.description}</p></article>)}</div></section>
<section class="about-section"><div class="about-grid reverse-about"><figure class="about-image"><Photo image="bxcz-2" alt={t('爆笑虫子项目的趣味空间','A playful world from Larva')}/></figure><div class="about-text"><h2 class="serif-font">{t('让参与，推动故事。','Let participation move the story.')}</h2><p>{t('把观看、行走、探索与角色交流放在同一条体验路径里。围绕内容设计交互节点、场景衔接与反馈，让观众的行动与故事彼此关联。','Viewing, walking, exploring and meeting characters become part of one experience. Interaction, transitions and feedback connect the audience’s actions to the unfolding story.')}</p><a class="btn-book" href={href('/projects/')}>{t('探索我们的作品','Explore our work')}</a></div></div></section>
<section class="vision-section"><Photo image="taosi-3" alt="" class="vision-background"/><div class="vision-overlay"></div><div class="vision-content"><h2 class="serif-font">{t('下一个世界，与你一起创造。','The next world, created together.')}</h2><a class="btn-book" href={href('/collaboration/')}>{t('联系合作','Get in touch')}</a></div></section>
</Layout>
