---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/studio';
import {choose,type Locale} from '../data/i18n';
interface Props {locale:Locale;}
const {locale}=Astro.props,t=choose(locale);
---
<Layout title={t('联系我们','Contact us')} page="collaboration" locale={locale}>
<div class="contact-container" id="contact"><section class="contact-left"><h1 class="contact-title serif-font">{t('期待','Looking forward')}<br/>{t('与您相遇。','to meeting you.')}</h1><p class="contact-desc">{t('无论是内容共创、制作协作，还是沉浸式体验的商务合作，期待与你展开交流。','For content creation, production collaboration and immersive experiences, we look forward to hearing from you.')}</p><dl class="contact-info"><div><dt>{t('商务邮箱','EMAIL')}</dt><dd>{site.email?<a href={'mailto:'+site.email}>{site.email}</a>:t('邮箱待补充','Email to be added')}</dd></div><div><dt>{t('联系电话','PHONE')}</dt><dd>{site.phone?<a href={'tel:'+site.phone}>{site.phone}</a>:t('电话待补充','Phone to be added')}</dd></div><div><dt>{t('微信咨询','WECHAT')}</dt><dd>{site.wechat||t('微信待补充','WeChat to be added')}</dd></div><div><dt>{t('工作室地址','ADDRESS')}</dt><dd>{t('地址待补充','Address to be added')}</dd></div></dl></section>
<section class="contact-right"><h2 class="serif-font">{t('在线留言','Leave a message')}</h2><form aria-describedby="contact-status"><div class="form-group"><label class="sr-only" for="contact-name">{t('您的姓名','Your name')}</label><input class="form-input" id="contact-name" name="name" autocomplete="name" placeholder={t('您的姓名','Your name')} disabled/></div><div class="form-group"><label class="sr-only" for="contact-way">{t('联系方式','Contact details')}</label><input class="form-input" id="contact-way" name="contact" placeholder={t('电话或邮箱','Phone or email')} disabled/></div><div class="form-group"><label class="sr-only" for="contact-subject">{t('咨询主题','Subject')}</label><input class="form-input" id="contact-subject" name="subject" placeholder={t('咨询主题','Subject')} disabled/></div><div class="form-group"><label class="sr-only" for="contact-message">{t('留言内容','Message')}</label><textarea class="form-input" id="contact-message" name="message" rows="6" placeholder={t('告诉我们你的项目想法','Tell us about your project')} disabled></textarea></div><button class="btn-submit" type="button" disabled>{t('留言功能待开通','Messaging coming soon')}</button><p class="contact-status" id="contact-status">{t('商务联系方式更新后开放在线留言。','Online messaging will open when our business contact details are available.')}</p></form></section></div>
</Layout>
